{
  "manifest_version": 3,
  "name": "Desktop Pet Mascot - Anya Forger 🎀",
  "version": "1.0.0",
  "description": "Bé Anya Chibi đáng yêu chạy nhảy, đi dạo, kéo thả rơi trọng lực và trò chuyện Gemini AI trên mọi trang web!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Desktop Pet Anya 🎀"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sprites/*",
        "assets/sounds/*",
        "icons/*",
        "playground.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
